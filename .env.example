# S-03 — Variables de entorno de producción
# Copiar a .env y rellenar TODOS los valores antes de desplegar.
# NUNCA commitear el .env real.
# Fuente de verdad de nombres y defaults: backend/core/config.py (clase Settings)

# ── Servidor ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=False
LOG_LEVEL=INFO

# ── Dominio ───────────────────────────────────────────────────────────────────
DOMAIN=sirccd.example.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# Lista JSON de orígenes permitidos. En producción, limitar a los dominios reales.
ALLOWED_ORIGINS=["https://sirccd.example.com"]

# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sirccd_user
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_FUERTE_AQUI
POSTGRES_DB=sirccd_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Generar: openssl rand -hex 32
REDIS_PASSWORD=CAMBIAR_REDIS_PASSWORD_AQUI

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=sirccd_admin
# Generar: openssl rand -hex 24
MINIO_SECRET_KEY=CAMBIAR_MINIO_SECRET_AQUI
MINIO_SECURE=True
MINIO_BUCKET_IMAGES=sirccd-images
MINIO_BUCKET_MODELS=sirccd-models
MINIO_SSE_ENABLED=True

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generar: openssl rand -hex 32
SECRET_KEY=CAMBIAR_JWT_SECRET_AQUI
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Cifrado de campos en BD (S-03) ────────────────────────────────────────────
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=CAMBIAR_FERNET_KEY_AQUI

# ── ML / Roboflow (detección de daños) ────────────────────────────────────────
ROBOFLOW_API_KEY=CAMBIAR_ROBOFLOW_KEY_AQUI
ROBOFLOW_MODEL_ID=rd-roaddataset/5
CONFIDENCE_THRESHOLD=0.4
IOU_THRESHOLD=0.4

# ── Deduplicación (FAISS + embeddings visuales) ───────────────────────────────
FAISS_INDEX_PATH=storage/faiss_index.bin
DEDUPLICATION_VISUAL_MODEL=resnet50
DEDUPLICATION_SECONDARY_MODEL=clip-vit-base-patch32
DEDUPLICATION_ALLOW_HISTOGRAM_FALLBACK=True
VISUAL_SIMILARITY_THRESHOLD=0.15
GEO_DISTANCE_THRESHOLD=50.0
DEDUP_TIME_WINDOW_DAYS=30
DEDUP_VISUAL_GATE_THRESHOLD=0.82
DEDUPLICATION_SCORE_THRESHOLD=0.72
DEDUPLICATION_VISUAL_WEIGHT_PRIMARY=0.45
DEDUPLICATION_VISUAL_WEIGHT_SECONDARY=0.25
DEDUPLICATION_GEO_WEIGHT=0.20
DEDUPLICATION_TEXT_WEIGHT=0.10

# ── Priorización (proximidad a POIs, también configurable en runtime vía
#    PUT /api/v1/admin/settings/priority) ─────────────────────────────────────
PRIORITY_POI_RADIUS_METERS=500
PRIORITY_DUPLICATE_RADIUS_METERS=100
PRIORITY_DUPLICATE_TIME_WINDOW_DAYS=30

# ── SMTP (alertas SLA, opcional) ───────────────────────────────────────────────
SMTP_ENABLED=False
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@sirccd.example.com
SMTP_PASSWORD=CAMBIAR_SMTP_PASSWORD_AQUI
SMTP_FROM=noreply@sirccd.example.com

# ── SLA ───────────────────────────────────────────────────────────────────────
SLA_WARNING_HOURS_BEFORE=4.0
SLA_CHECK_INTERVAL_MINUTES=30

# ── Setup inicial (solo para scripts/seed_admin.py, no leído por core/config.py) ──
# No dejar estos valores en un .env real de producción de forma permanente;
# pasarlos como variables de entorno puntuales al ejecutar el script una vez.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sirccd.example.com
ADMIN_PASSWORD=CAMBIAR_ADMIN_PASSWORD_AQUI
ADMIN_FULL_NAME=Administrador SIRCCD
