# S-03 — Variables de entorno de producción
# Copiar a .env y rellenar TODOS los valores antes de desplegar.
# NUNCA commitear el .env real.

# ── Dominio ───────────────────────────────────────────────────────────────────
DOMAIN=sirccd.example.com

# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_USER=sirccd_user
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_FUERTE_AQUI
POSTGRES_DB=sirccd_db

# ── Redis ─────────────────────────────────────────────────────────────────────
# Generar: openssl rand -hex 32
REDIS_PASSWORD=CAMBIAR_REDIS_PASSWORD_AQUI

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=sirccd_admin
# Generar: openssl rand -hex 24
MINIO_SECRET_KEY=CAMBIAR_MINIO_SECRET_AQUI

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generar: openssl rand -hex 32
SECRET_KEY=CAMBIAR_JWT_SECRET_AQUI

# ── Cifrado de campos en BD (S-03) ────────────────────────────────────────────
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=CAMBIAR_FERNET_KEY_AQUI

# ── ML / Roboflow ─────────────────────────────────────────────────────────────
ROBOFLOW_API_KEY=CAMBIAR_ROBOFLOW_KEY_AQUI
ROBOFLOW_MODEL_ID=rd-roaddataset/5
