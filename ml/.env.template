# Configuración de entorno ML - SIRCCD
# M-01: Variables de entorno para entrenamiento

# ===== MinIO ===== 
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=sirccd_admin
MINIO_SECRET_KEY=sirccd_password_2026
MINIO_BUCKET=sirccd-datasets
MINIO_VERSION=v1.0.0

# ===== Weights & Biases (opcional) =====
# Descomentar y configurar si deseas usar W&B para tracking
# WANDB_API_KEY=your_wandb_api_key_here
# WANDB_PROJECT=sirccd-road-damage
# WANDB_ENTITY=your_username_or_team

# ===== Google Places API =====
# Ya configurado en datasets/, pero se puede compartir aquí
GOOGLE_PLACES_API_KEY=your_google_api_key_here

# ===== PyTorch =====
# Directorio de cache para modelos pre-entrenados
TORCH_HOME=.cache/torch

# GPU a usar (si hay múltiples GPUs)
# 0 = primera GPU, 1 = segunda GPU, etc.
# -1 = CPU only
CUDA_VISIBLE_DEVICES=0

# ===== Reproducibilidad =====
# Seed para aleatorización consistente
PYTHONHASHSEED=42
RANDOM_SEED=42

# ===== Rutas de Datos =====
# Rutas relativas al directorio ml/
DATASET_DIR=datasets/processed/split
ANONYMIZED_DIR=datasets/processed/anonymized
MODELS_DIR=models
RUNS_DIR=runs

# ===== Configuración de Entrenamiento =====
# Hiperparámetros por defecto (pueden sobrescribirse en código)
DEFAULT_EPOCHS=100
DEFAULT_BATCH_SIZE=16
DEFAULT_IMAGE_SIZE=640
DEFAULT_WORKERS=4

# ===== Database (PostgreSQL/PostGIS) =====
# Configurar cuando se implemente backend
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sirccd
# DB_USER=sirccd_user
# DB_PASSWORD=sirccd_password

# ===== Logging =====
LOG_LEVEL=INFO
LOG_DIR=logs

# ===== Notificaciones (opcional) =====
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL
